# Configurazione della sorveglianza casella TPL.
# Copiare in /etc/tpl-inbox-watch/env (proprietario root, permessi 0640).

# --- Casella da sorvegliare -------------------------------------------------
TPL_IMAP_HOST=mail.comune.esempio.it
TPL_IMAP_PORT=993
TPL_IMAP_USER=casella@comune.esempio.it
TPL_IMAP_PASSWORD=
TPL_IMAP_FOLDER=INBOX

# --- Invio della notifica ---------------------------------------------------
TPL_SMTP_HOST=mail.comune.esempio.it
TPL_SMTP_PORT=587
# Se vuoti si riusano le credenziali IMAP.
TPL_SMTP_USER=
TPL_SMTP_PASSWORD=

TPL_EMAIL_FROM=casella@comune.esempio.it
TPL_EMAIL_FROM_NAME="Casella TPL Imperia"
TPL_EMAIL_TO=nome.cognome@comune.esempio.it
TPL_EMAIL_CC=

# --- Notifica Telegram (facoltativa) ---------------------------------------
# Piu destinatari: separare i chat_id con la virgola. Ognuno deve aver aperto
# una conversazione col bot.
TPL_TELEGRAM_TOKEN=
TPL_TELEGRAM_CHAT_ID=

# --- Comportamento ----------------------------------------------------------
# Mittenti da non segnalare: notifiche di servizio, non richieste dei cittadini.
TPL_IGNORA_MITTENTI=noreply@github.com,mailer-daemon@
TPL_STATE_FILE=${HOME}/.local/state/tpl-inbox-watch.json

# Caratteri di anteprima del corpo mostrati nella notifica.
# A 0 il corpo non viene nemmeno scaricato: si leggono i soli header.
TPL_LUNGHEZZA_ANTEPRIMA=256

# Elenco dei destinatari gestito dall'interfaccia web, se presente ha la
# precedenza sulle due variabili qui sopra. Vuoto: si usano solo le variabili.
TPL_DESTINATARI_FILE=
